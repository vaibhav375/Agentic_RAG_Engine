# Copy to .env and fill in only what you use.
# Mock mode needs none of these. `local` mode (Ollama + sentence-transformers)
# needs none of these either — open weights, no accounts.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Open-weight models on an OpenAI-compatible host -------------------------
# `llm.provider: openai` + `llm.base_url` reaches any OpenAI-compatible endpoint,
# so open-weight models too large to run locally (e.g. Kimi K2, ~1T params MoE)
# need no new backend — just a base_url, a model id, and whichever key env var
# that host uses (llm.api_key_env).
# MOONSHOT_API_KEY=      # base_url https://api.moonshot.ai/v1
# OPENROUTER_API_KEY=    # base_url https://openrouter.ai/api/v1
# TOGETHER_API_KEY=      # base_url https://api.together.xyz/v1
# GROQ_API_KEY=          # base_url https://api.groq.com/openai/v1
# A self-hosted vLLM / llama.cpp server needs no key at all:
# ARAG_LLM__BASE_URL=http://localhost:8000/v1

# Optional overrides (any config path, __ separates nesting)
# ARAG_MODE=local
# ARAG_LLM__PROVIDER=ollama
# ARAG_LLM__OLLAMA_MODEL=qwen3:4b
# ARAG_EMBEDDINGS__PROVIDER=sentence_transformers
# ARAG_RETRIEVAL__USE_HYBRID=true
